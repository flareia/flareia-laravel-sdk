{
    "name": "flareia/laravel-sdk",
    "version": "0.1.1",
    "description": "Reports exceptions from a Laravel application to a FlareIA instance.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://flareia.com.br",
    "authors": [
        {
            "name": "FlareIA",
            "homepage": "https://flareia.com.br"
        }
    ],
    "support": {
        "source": "https://github.com/flareia/flareia-laravel-sdk"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "flareia/php-sdk": "^0.1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "FlareIA\\Sdk\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FlareIA\\Sdk\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FlareIA\\Sdk\\Laravel\\FlareIAServiceProvider"
            ],
            "aliases": {
                "FlareIA": "FlareIA\\Sdk\\Laravel\\Facades\\FlareIA"
            }
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
